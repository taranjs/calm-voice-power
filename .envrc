# .envrc – which Cloudflare account this project deploys to.
#
# Wrangler prefers CLOUDFLARE_API_TOKEN over whatever `wrangler login` last left
# lying around, so setting it here pins this repo to one account and leaves your
# global OAuth session alone. No logout/login dance, and no chance of publishing
# a child's app to the wrong account because of what you were signed into last.
#
# The token is never in this file and never in git. Store it once with:
#     ./tools/cf-auth.sh
# It goes into the macOS keychain. A gitignored .env.local works too, and wins
# if both exist — handy for a throwaway token you want to delete afterwards.

# A missing token must not break `cd` into the directory, so every lookup here
# is allowed to fail quietly.
_cv_keychain() {
  security find-generic-password -s calm-voice-power -a "$1" -w 2>/dev/null || true
}

[ -f .env.local ] && dotenv .env.local

if [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
  _tok="$(_cv_keychain CLOUDFLARE_API_TOKEN)"
  [ -n "$_tok" ] && export CLOUDFLARE_API_TOKEN="$_tok"
  unset _tok
fi

if [ -z "${CLOUDFLARE_ACCOUNT_ID:-}" ]; then
  _acc="$(_cv_keychain CLOUDFLARE_ACCOUNT_ID)"
  [ -n "$_acc" ] && export CLOUDFLARE_ACCOUNT_ID="$_acc"
  unset _acc
fi

if [ -n "${CLOUDFLARE_API_TOKEN:-}" ]; then
  # Only ever echo the account id, which is not a secret. Never the token.
  log_status "Cloudflare: project token loaded${CLOUDFLARE_ACCOUNT_ID:+ (account ${CLOUDFLARE_ACCOUNT_ID:0:8}…)}"
else
  log_status "Cloudflare: no project token — run ./tools/cf-auth.sh, or deploys fall back to your global wrangler login"
fi
